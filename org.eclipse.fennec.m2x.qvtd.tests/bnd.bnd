Test-Cases: ${classes;HIERARCHY_INDIRECTLY_ANNOTATED;org.junit.platform.commons.annotation.Testable;CONCRETE}
Bundle-Name: Fennec QVT-R Tests
Bundle-Description: Parser and engine tests for QVT-Relations

-library: \
	enableEMF,\
	enableOSGi-Test

src=${^src}

-includeresource.model: model=model

-buildpath: \
	org.osgi.service.component;version=latest,\
	org.osgi.dto;version=latest,\
	org.eclipse.fennec.m2x.unit;version=snapshot,\
	org.eclipse.fennec.emf.osgi.api;version=latest,\
	org.eclipse.fennec.emf.osgi.component.minimal;version=latest,\
	org.osgi.test.junit5.cm;version=latest,\
	org.antlr.antlr4-runtime;version=latest,\
	org.eclipse.fennec.m2x.qvtd.parser;version=snapshot,\
	org.eclipse.fennec.m2x.qvtd.engine;version=snapshot;packages='*',\
	org.eclipse.fennec.m2x.qvtd.api;version=snapshot,\
	org.eclipse.fennec.m2x.qvt.model;version=snapshot,\
	org.eclipse.fennec.m2x.qvtd.model;version=snapshot,\
	org.eclipse.fennec.m2x.qvto.api;version=snapshot,\
	org.eclipse.fennec.m2x.qvto.model;version=snapshot,\
	org.eclipse.fennec.m2x.qvto.engine;version=snapshot,\
	org.eclipse.fennec.m2x.qvto.parser;version=snapshot,\
	org.eclipse.fennec.m2x.ocl.api;version=snapshot,\
	org.eclipse.fennec.m2x.ocl.model;version=snapshot,\
	org.eclipse.fennec.m2x.ocl.engine;version=snapshot,\
	org.eclipse.fennec.m2x.ocl.parser;version=snapshot,\
	org.eclipse.fennec.m2x;version=snapshot
