Bundle-Name: Fennec QVT-O Parser
Bundle-Description: ANTLR4-based parser for QVT-Operational v1.3 transformations

-library: enableEMF

src=${^src},src-gen

antlr4-version = 4.13.2

antlr4.tool.cp = \
	${repo;org.antlr:antlr4;${antlr4-version}}:\
	${repo;org.antlr:antlr4-runtime;${antlr4-version}}:\
	${repo;org.antlr:antlr-runtime;3.5.3}:\
	${repo;org.antlr:ST4;4.3.4}:\
	${repo;org.abego.treelayout:org.abego.treelayout.core;1.0.3}:\
	${repo;com.ibm.icu:icu4j;72.1}

-generate: \
	grammar/QvtO.g4; \
		output=src-gen; \
		system='java -cp ${antlr4.tool.cp} org.antlr.v4.Tool \
			-visitor -no-listener \
			-lib ${project}/../org.eclipse.fennec.m2m.ocl.parser/grammar \
			-package org.eclipse.fennec.m2m.qvto.parser \
			-o src-gen/org/eclipse/fennec/m2m/qvto/parser \
			${project}/grammar/QvtO.g4'

# Include grammar file for downstream import
-includeresource.grammar: grammar=grammar

# Suppress deprecation warnings from ANTLR4-generated code (tokenNames -> VOCABULARY)
javac.deprecation = false

-buildpath: \
	org.antlr.antlr4-runtime;version=latest,\
	org.eclipse.fennec.m2m.ocl.api;version=latest,\
	org.eclipse.fennec.m2m.ocl.model;version=latest,\
	org.eclipse.fennec.m2m.qvto.api;version=latest,\
	org.eclipse.fennec.m2m.qvto.model;version=latest,\
	org.osgi.service.condition;version=latest
