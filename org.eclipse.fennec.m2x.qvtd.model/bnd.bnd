Bundle-Name: Fennec QVT-R Model
Bundle-Description: QVT-Relations v1.3 EMF metamodel (2 EPackages: qvtrelation, qvttemplate)

-library: enableEMF

# Modify model only on demand
#-generate:\
#	model/qvtd.genmodel;\
#		generate=fennecEMF;\
#		genmodel=model/qvtd.genmodel;\
#		lineEndings=lf;\
#		output=src

-includeresource.model: model=model

-buildpath: \
	org.eclipse.fennec.m2x.ocl.model;version=snapshot,\
	org.eclipse.fennec.m2x.qvt.model;version=snapshot,\
	org.osgi.service.condition;version=latest
