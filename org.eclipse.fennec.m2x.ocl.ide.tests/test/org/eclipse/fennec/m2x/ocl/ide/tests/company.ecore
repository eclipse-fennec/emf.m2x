<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="company"
    nsURI="http://example.org/fennec/company/1.0"
    nsPrefix="company">

  <!--
    Tell EMF which delegate URI to use for OCL setting (derive), invocation
    (operation body) and validation (invariants). The Fennec OCL IDE bundle
    (org.eclipse.fennec.m2x.ocl.ide) registers these delegate factories under
    this URI, so the generic (reflective) EMF editor evaluates the OCL below.
  -->
  <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
    <details key="settingDelegates" value="http://www.eclipse.org/fennec/m2x/ocl/1.0"/>
    <details key="invocationDelegates" value="http://www.eclipse.org/fennec/m2x/ocl/1.0"/>
    <details key="validationDelegates" value="http://www.eclipse.org/fennec/m2x/ocl/1.0"/>
  </eAnnotations>

  <eClassifiers xsi:type="ecore:EClass" name="Employee">

    <!-- Names of the OCL invariants defined on this class (validation delegate) -->
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="agePositive nameNotEmpty salaryNonNegative"/>
    </eAnnotations>
    <!-- The OCL bodies of those invariants, keyed by constraint name -->
    <eAnnotations source="http://www.eclipse.org/fennec/m2x/ocl/1.0">
      <details key="agePositive" value="self.age &gt; 0"/>
      <details key="nameNotEmpty" value="self.name.size() &gt; 0"/>
      <details key="salaryNonNegative" value="self.salary &gt;= 0.0"/>
    </eAnnotations>

    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="age"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="salary"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>

    <!-- Derived feature: value computed by the OCL setting delegate -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nameLength"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        changeable="false" volatile="true" transient="true" derived="true">
      <eAnnotations source="http://www.eclipse.org/fennec/m2x/ocl/1.0">
        <details key="derivation" value="self.name.size()"/>
      </eAnnotations>
    </eStructuralFeatures>

    <eStructuralFeatures xsi:type="ecore:EAttribute" name="adult"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        changeable="false" volatile="true" transient="true" derived="true">
      <eAnnotations source="http://www.eclipse.org/fennec/m2x/ocl/1.0">
        <details key="derivation" value="self.age &gt;= 18"/>
      </eAnnotations>
    </eStructuralFeatures>

    <!-- Operation body: evaluated by the OCL invocation delegate -->
    <eOperations name="greeting"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/fennec/m2x/ocl/1.0">
        <details key="body" value="'Hello, '.concat(self.name)"/>
      </eAnnotations>
    </eOperations>

    <eOperations name="raiseSalary"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble">
      <eParameters name="amount"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
      <eAnnotations source="http://www.eclipse.org/fennec/m2x/ocl/1.0">
        <details key="body" value="self.salary + amount"/>
      </eAnnotations>
    </eOperations>

  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Department">

    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="hasEmployees"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/fennec/m2x/ocl/1.0">
      <details key="hasEmployees" value="self.employees-&gt;notEmpty()"/>
    </eAnnotations>

    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees"
        upperBound="-1" eType="#//Employee" containment="true"/>

    <!-- Derived features over a collection (setting delegate) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="headcount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        changeable="false" volatile="true" transient="true" derived="true">
      <eAnnotations source="http://www.eclipse.org/fennec/m2x/ocl/1.0">
        <details key="derivation" value="self.employees-&gt;size()"/>
      </eAnnotations>
    </eStructuralFeatures>

    <eStructuralFeatures xsi:type="ecore:EAttribute" name="totalSalary"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"
        changeable="false" volatile="true" transient="true" derived="true">
      <eAnnotations source="http://www.eclipse.org/fennec/m2x/ocl/1.0">
        <details key="derivation" value="self.employees.salary-&gt;sum()"/>
      </eAnnotations>
    </eStructuralFeatures>

    <!-- Multi-valued operation: result wrapped as an EList by the invocation delegate -->
    <eOperations name="findByName" upperBound="-1" eType="#//Employee">
      <eParameters name="n"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eAnnotations source="http://www.eclipse.org/fennec/m2x/ocl/1.0">
        <details key="body" value="self.employees-&gt;select(e | e.name = n)"/>
      </eAnnotations>
    </eOperations>

  </eClassifiers>

</ecore:EPackage>
