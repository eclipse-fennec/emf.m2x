Bundle-Name: Fennec QVT-O API
Bundle-Description: Public API interfaces for the Fennec QVT-O transformation engine

-library: enableEMF

-buildpath: \
	org.eclipse.fennec.m2x.ocl.api;version=snapshot,\
	org.eclipse.fennec.m2x.ocl.model;version=snapshot,\
	org.eclipse.fennec.m2x.qvt.model;version=snapshot,\
	org.eclipse.fennec.m2x.qvto.model;version=snapshot,\
	org.osgi.service.condition;version=latest
