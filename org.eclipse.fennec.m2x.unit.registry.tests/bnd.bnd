Test-Cases: ${classes;HIERARCHY_INDIRECTLY_ANNOTATED;org.junit.platform.commons.annotation.Testable;CONCRETE}
Bundle-Name: Fennec M2X Unit Registry Tests
Bundle-Description: Integration tests for the object medium: a UnitStore over an EObjectRegistry \
 fed from files, wired through configuration alone (#213).

-library: \
	enableEMF,\
	enableOSGi-Test

src=${^src}

-buildpath: \
	org.osgi.service.cm;version=latest,\
	org.eclipse.fennec.emf.osgi.api;version=latest,\
	org.eclipse.fennec.emf.osgi.component.minimal;version=latest,\
	org.eclipse.fennec.emf.osgi.eobject.registry;version=latest,\
	org.eclipse.fennec.m2x.unit;version=snapshot,\
	org.eclipse.fennec.m2x.unit.registry;version=snapshot,\
	org.eclipse.fennec.m2x.ocl.model;version=snapshot,\
	org.eclipse.fennec.m2x.m2t.model;version=snapshot
