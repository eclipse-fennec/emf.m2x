Bundle-Name: Fennec M2T Parser
Bundle-Description: ANTLR4-based parser for MOFM2T v1.0 templates

-library: enableEMF

src=${^src},src-gen

antlr4-version = 4.13.2

antlr4.tool.cp = \
	${repo;org.antlr:antlr4;${antlr4-version}}:\
	${repo;org.antlr:antlr4-runtime;${antlr4-version}}:\
	${repo;org.antlr:antlr-runtime;3.5.3}:\
	${repo;org.antlr:ST4;4.3.4}:\
	${repo;org.abego.treelayout:org.abego.treelayout.core;1.0.3}:\
	${repo;com.ibm.icu:icu4j;72.1}

# Split grammar: run grammar/generate.sh manually to regenerate src-gen/, then commit what it
# produced. The instruction below stays commented out, as its own comment always said it was:
# bnd empties the output directory before it runs the generation, and the generation is a shell
# script that exists on Linux and macOS only — so on Windows an ordinary build deleted the
# checked-in sources and put nothing in their place (#168). The same shape is used by the model
# projects (see ocl.model/bnd.bnd).
#-generate: \
#	grammar/M2tLexer.g4; \
#		output=src-gen; \
#		system='${project}/grammar/generate.sh \
#			${antlr4.tool.cp} \
#			src-gen/org/eclipse/fennec/m2x/m2t/parser \
#			${project}/grammar'

# Include grammar file for downstream import
-includeresource.grammar: grammar=grammar

# Suppress deprecation warnings from ANTLR4-generated code (tokenNames -> VOCABULARY)
javac.deprecation = false

-buildpath: \
	org.antlr.antlr4-runtime;version=latest,\
	org.eclipse.fennec.m2x.ocl.api;version=snapshot,\
	org.eclipse.fennec.m2x.ocl.model;version=snapshot,\
	org.eclipse.fennec.m2x.ocl.parser;version=snapshot,\
	org.eclipse.fennec.m2x.m2t.api;version=snapshot,\
	org.eclipse.fennec.m2x.m2t.model;version=snapshot,\
	org.osgi.service.condition;version=latest
