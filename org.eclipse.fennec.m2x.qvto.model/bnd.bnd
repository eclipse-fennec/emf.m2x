Bundle-Name: Fennec QVT-O Model
Bundle-Description: QVT-Operational v1.3 EMF metamodel (3 EPackages, 59 classifiers)

-library: enableEMF

# Modify model only on demand
#-generate:\
#	model/qvto.genmodel;\
#		generate=fennecEMF;\
#		genmodel=model/qvto.genmodel;\
#		output=src

-includeresource.model: model=model

-buildpath: \
	org.eclipse.fennec.m2x.ocl.model;version=snapshot,\
	org.eclipse.fennec.m2x.qvt.model;version=snapshot,\
	org.osgi.service.condition;version=latest
