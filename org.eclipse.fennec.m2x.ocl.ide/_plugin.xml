  Registers the Fennec OCL delegates with EMF's delegate registries so that the
  generic (reflective) EMF editor evaluates OCL annotations. Each delegate is
  registered under both the Fennec URI and the legacy Eclipse OCL Pivot URI, so
  models authored against either are evaluated by the Fennec engine.
-->
<plugin>

   <!-- Invariant constraints on EClasses / EOperations -->
   <extension point="org.eclipse.emf.ecore.validation_delegate">
      <delegate
            uri="http://www.eclipse.org/fennec/m2x/ocl/1.0"
            class="org.eclipse.fennec.m2x.ocl.ide.OclValidationDelegate"/>
      <delegate
            uri="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot"
            class="org.eclipse.fennec.m2x.ocl.ide.OclValidationDelegate"/>
   </extension>

   <!-- Derivation expressions for derived structural features -->
   <extension point="org.eclipse.emf.ecore.setting_delegate">
      <factory
            uri="http://www.eclipse.org/fennec/m2x/ocl/1.0"
            class="org.eclipse.fennec.m2x.ocl.ide.OclSettingDelegateFactory"/>
      <factory
            uri="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot"
            class="org.eclipse.fennec.m2x.ocl.ide.OclSettingDelegateFactory"/>
   </extension>

   <!-- Operation bodies, pre- and postconditions -->
   <extension point="org.eclipse.emf.ecore.invocation_delegate">
      <factory
            uri="http://www.eclipse.org/fennec/m2x/ocl/1.0"
            class="org.eclipse.fennec.m2x.ocl.ide.OclInvocationDelegateFactory"/>
      <factory
            uri="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot"
            class="org.eclipse.fennec.m2x.ocl.ide.OclInvocationDelegateFactory"/>
   </extension>

</plugin>
