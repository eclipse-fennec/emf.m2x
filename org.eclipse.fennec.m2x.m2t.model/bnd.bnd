Bundle-Name: Fennec M2T Model
Bundle-Description: MOFM2T v1.0 EMF metamodel (2 EEnums, 17 EClasses)

-library: enableEMF

-generate:\
	model/m2t.genmodel;\
		generate=fennecEMF;\
		genmodel=model/m2t.genmodel;\
		output=src

-includeresource.model: model=model

-buildpath: \
	org.eclipse.fennec.m2x.ocl.model;version=latest,\
	org.osgi.service.condition;version=latest
