Bundle-Name: Fennec M2X Unit OSGi
Bundle-Description: The OSGi half of the language-neutral unit contracts: whiteboard resolution of compilation units by name

-library: enableEMF

# Deliberately its own bundle (D39, #192): org.eclipse.fennec.m2x.unit is framework-neutral,
# so that every engine works as a plain Java library. What needs a BundleContext lives here,
# and the dependency points this way and never back.

-buildpath: \
	org.eclipse.fennec.m2x.unit;version=snapshot,\
	org.eclipse.fennec.emf.osgi.api;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.condition;version=latest
