Bundle-Name: Fennec OCL Engine
Bundle-Description: OCL v2.5 evaluator, standard library, and EMF delegate integration

-library: enableEMF

-buildpath: \
	org.eclipse.fennec.m2x.ocl.api;version=latest,\
	org.eclipse.fennec.m2x.ocl.model;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.condition;version=latest
