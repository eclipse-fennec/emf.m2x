# We include setups for
#	Fennec Github-Configuration - fennec
#	OSGi-Test Support - fennec-osgitest
#	Jacoco Support - fennec-jacoco
-library: \
	fennec,\
	fennecTest,\
	fennecJacoco,\
	fennecEMF

# Needed because we enabled library 'fennec'
# Activate baselining
#fennec-baselining: true
github-orga: eclipse-fennec
github-project: emf.m2x
base-version: 0.1.1
Bundle-Version: ${base-version}.SNAPSHOT

# Maven Central Group-Id
# For Eclipse Fennec the groupid must start with org.eclipse.fennec
-groupid: org.eclipse.fennec.m2x

javac.source: 21
javac.target: 21

-require-bnd "(version>=7.2.1)"

-plugin.0.Central: \
    aQute.bnd.repository.maven.provider.MavenBndRepository; \
        snapshotUrl="https://central.sonatype.com/repository/maven-snapshots/"; \
        releaseUrl=https://repo.maven.apache.org/maven2/; \
        index=${.}/central.mvn; \
        readOnly=true; \
        poll.time=-1; \
        name="Central"
        
-plugin.1.Temp: \
	aQute.bnd.deployer.repository.LocalIndexedRepo; \
		name = Temp; \
		pretty = true; \
		local = ${build}/cache/temp
		
-plugin.2.Local: \
	aQute.bnd.deployer.repository.LocalIndexedRepo; \
		name = Local; \
		pretty = true; \
		local = ${build}/local
		
-plugin.3.Templates: \
	aQute.bnd.deployer.repository.LocalIndexedRepo; \
		name = Templates; \
		pretty = true; \
		local = ${build}/templates
		
-plugin.4.EMFCompare: \
 	aQute.bnd.repository.p2.provider.P2Repository; \
 	url = https://download.eclipse.org/modeling/emf/compare/updates/releases/latest/; \
 	name = EMFCompare
 	
-plugin.3.EclipseMDT-UML2: \
 	aQute.bnd.repository.p2.provider.P2Repository; \
 	url = https://download.eclipse.org/modeling/mdt/uml2/updates/releases/; \
 	name = EclipseMDT-UML2

# Enables `-export ...; type=p2` to produce an Eclipse p2 repository
# (used by org.eclipse.fennec.m2x.ocl.ide.p2).
-plugin.5.P2Export: \
	aQute.p2.export.P2Exporter

-fixupmessages: \
	"jpms.jarname calculated module";is:=ignore,\
	"No translation";is:=ignore,\
	"The .classpath contains";is:=ignore
