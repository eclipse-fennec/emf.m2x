-library: enableOSGi-Test

-runrequires: bnd.identity;id='org.eclipse.fennec.m2x.m2t.tests'

-runbundles.test: \
	org.eclipse.fennec.m2x.m2t.tests;version=snapshot

-runfw: org.apache.felix.framework

-runee: JavaSE-21

