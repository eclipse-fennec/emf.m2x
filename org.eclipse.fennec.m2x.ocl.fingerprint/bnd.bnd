Bundle-Name: Fennec OCL Fingerprint Cache
Bundle-Description: An OclExpressionCache keyed by the model fingerprint rather than \
 by the nsURI, so that two versions of one model do not share a compiled expression.

-library: enableEMF

src=${^src}

-buildpath: \
	org.eclipse.fennec.m2x.ocl.api;version=snapshot,\
	org.eclipse.fennec.m2x.ocl.model;version=snapshot,\
	org.eclipse.fennec.m2x.ocl.engine;version=snapshot,\
	org.eclipse.fennec.m2x.unit;version=snapshot,\
	org.eclipse.fennec.emf.osgi.api;version=latest

# The implementation is only needed to run the tests: FingerprintHelper is where a flat
# class path gets a FingerprintService from. The bundle itself compiles against the API.
-testpath: \
	org.eclipse.fennec.m2x.ocl.parser;version=snapshot,\
	org.antlr.antlr4-runtime;version=latest,\
	org.eclipse.fennec.emf.osgi.component.minimal;version=latest
