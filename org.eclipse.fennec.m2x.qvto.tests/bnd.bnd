Bundle-Name: Fennec QVT-O Tests
Bundle-Description: Parser and integration tests for QVT-O

-library: enableEMF

src=${^src}

-includeresource.model: model=model

-buildpath: \
	org.antlr.antlr4-runtime;version=latest,\
	org.eclipse.fennec.m2x.qvto.parser;version=snapshot,\
	org.eclipse.fennec.m2x.qvto.engine;version=snapshot,\
	org.eclipse.fennec.m2x.qvto.api;version=snapshot,\
	org.eclipse.fennec.m2x.qvto.model;version=snapshot,\
	org.eclipse.fennec.m2x.ocl.api;version=snapshot,\
	org.eclipse.fennec.m2x.ocl.model;version=snapshot,\
	org.eclipse.fennec.m2x.ocl.engine;version=snapshot,\
	org.eclipse.fennec.m2x.ocl.parser;version=snapshot,\
	org.eclipse.fennec.m2x;version=snapshot
