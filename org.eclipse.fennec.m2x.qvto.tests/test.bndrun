-library: enableOSGi-Test

-runrequires: bnd.identity;id='org.eclipse.fennec.m2x.qvto.tests'

-runbundles.test: \
	org.eclipse.fennec.m2x.qvto.tests;version=snapshot

-runfw: org.apache.felix.framework

# Aries SPI Fly, the Service Loader Mediator of OSGi Compendium 133, so that
# QvtoServiceDiscoveryOSGiTest makes its point in a framework that actually has one: a
# mediator weaves ServiceLoader.load in bundles that ask for it, and the engine bundle
# deliberately does not — so the class-path route stays inert and the service registry
# remains the only thing answering an import.
#
# The dynamic bundle rather than the framework extension, because it weaves through a
# WeavingHook and so has to read the class files it is handed: that needs ASM new enough
# for Java 21, which is why the ASM bundles are here and pinned alongside it.
-runrequires.spifly: \
	bnd.identity;id='org.apache.aries.spifly.dynamic.bundle'

-runee: JavaSE-21

-runbundles: \
	junit-jupiter-api;version='[5.14.2,5.14.3)',\
	junit-jupiter-params;version='[5.14.2,5.14.3)',\
	junit-platform-commons;version='[1.14.2,1.14.3)',\
	org.antlr.antlr4-runtime;version='[4.13.2,4.13.3)',\
	org.apache.aries.spifly.dynamic.bundle;version='[1.3.7,1.3.8)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.scr;version='[2.2.6,2.2.7)',\
	org.eclipse.emf.common;version='[2.44.0,2.44.1)',\
	org.eclipse.emf.ecore;version='[2.41.0,2.41.1)',\
	org.eclipse.emf.ecore.xmi;version='[2.39.0,2.39.1)',\
	org.eclipse.fennec.emf.osgi.component.minimal;version='[1.1.0,1.1.1)',\
	org.eclipse.fennec.m2x.ocl.api;version=snapshot,\
	org.eclipse.fennec.m2x.ocl.engine;version=snapshot,\
	org.eclipse.fennec.m2x.ocl.model;version=snapshot,\
	org.eclipse.fennec.m2x.ocl.parser;version=snapshot,\
	org.eclipse.fennec.m2x.qvt.model;version=snapshot,\
	org.eclipse.fennec.m2x.qvtd.api;version=snapshot,\
	org.eclipse.fennec.m2x.qvtd.model;version=snapshot,\
	org.eclipse.fennec.m2x.qvto.api;version=snapshot,\
	org.eclipse.fennec.m2x.qvto.engine;version=snapshot,\
	org.eclipse.fennec.m2x.qvto.model;version=snapshot,\
	org.eclipse.fennec.m2x.qvto.parser;version=snapshot,\
	org.eclipse.fennec.m2x.qvto.tests;version=snapshot,\
	org.eclipse.fennec.m2x.unit;version=snapshot,\
	org.eclipse.fennec.m2x.unit.osgi;version=snapshot,\
	org.objectweb.asm;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.commons;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.tree;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.tree.analysis;version='[9.9.1,9.9.2)',\
	org.objectweb.asm.util;version='[9.9.1,9.9.2)',\
	org.opentest4j;version='[1.3.0,1.3.1)',\
	org.osgi.service.cm;version='[1.6.1,1.6.2)',\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.test.common;version='[1.3.0,1.3.1)',\
	org.osgi.test.junit5;version='[1.3.0,1.3.1)',\
	org.osgi.test.junit5.cm;version='[1.3.0,1.3.1)',\
	org.osgi.util.converter;version='[1.0.9,1.0.10)',\
